{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": "Keep GitHub Actions up to date in small, reviewed batches. News, biographies and historical sources are outside Renovate scope.",
  "enabledManagers": [
    "github-actions"
  ],
  "timezone": "Europe/Athens",
  "schedule": [
    "* 1-5 * * 1-5"
  ],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "automerge": false,
  "labels": [
    "dependency-maintenance"
  ],
  "packageRules": [
    {
      "description": "Group nonmajor updates for GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "GitHub Actions maintenance"
    }
  ]
}
