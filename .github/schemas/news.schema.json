{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Archelaos public news feed",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "version": {
      "type": [
        "number",
        "string"
      ]
    },
    "updated": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string"
          },
          "personIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
