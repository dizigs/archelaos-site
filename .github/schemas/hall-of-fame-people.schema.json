{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Archelaos public Hall of Fame",
  "type": "object",
  "required": [
    "people",
    "count"
  ],
  "properties": {
    "version": {
      "type": [
        "number",
        "string"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
