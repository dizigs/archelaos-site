    "stories": [
      {
        "id": 1,
        "title_el": "Οι άστεγοι Κυπελλούχοι και το γήπεδο που έλειπε",
        "status": "translation_needed"
      },
      {
        "id": 2,
        "title_el": "Από το παλιό γήπεδο του Πάρκου μέχρι τη Γαλλία",
        "status": "translation_needed"
      },
      {
        "id": 3,
        "title_el": "Το τόξο που έψαχνε γήπεδο και βρήκε ομοσπονδία",
        "status": "translation_needed"
      },
      {
        "id": 4,
        "title_el": "Ο Παναθηναϊκός στην αυλή του σχολείου",
        "status": "translation_needed"
      },
      {
        "id": 5,
        "title_el": "Πρώτα φτιάξαμε αίθουσα. Μετά ήρθαν τα μετάλλια.",
        "status": "translation_needed"
      },
      {
        "id": 6,
        "title_el": "Πέντε χρυσά στην Καλαμάτα, αλλά η πισίνα δεν περίσσευε",
        "status": "translation_needed"
      },
      {
        "id": 7,
        "title_el": "Οι πρωταθλητές, η αποθήκη του σταθμού και οι 112,59 βαθμοί",
        "status": "translation_needed"
      },
      {
        "id": 8,
        "title_el": "Δύο ονόματα, μία φανέλα και μια μεγάλη απόφαση",
        "status": "translation_needed"
      },
      {
        "id": 9,
        "title_el": "Δεκαοκτώ σωματεία, δεκαπέντε πόλεις — και ο λογαριασμός στον Αρχέλαο",
        "status": "translation_needed"
      },
      {
        "id": 10,
        "title_el": "Πώς ένα ταρτάν κράτησε τα Δίια στην αναμονή",
        "status": "translation_needed"
      },
      {
        "id": 11,
        "title_el": "Δύο αγώνες με την Τιφλίδα και το ευρωπαϊκό εισιτήριο που δεν χαρίστηκε",
        "status": "translation_needed"
      },
      {
        "id": 12,
        "title_el": "Οι αφανείς βάρδιες του χάντμπολ: Λάκης και Πόπη Χαρικλειά",
        "status": "translation_needed"
      },
      {
        "id": 13,
        "title_el": "Ο έφορος, τα ξενοδοχεία και οι επιχορηγήσεις που αργούσαν",
        "status": "translation_needed"
      },
      {
        "id": 14,
        "title_el": "Ο πόλεμος άλλαξε την έδρα, όχι το ταξίδι του Αρχέλαου",
        "status": "translation_needed"
      },
      {
        "id": 15,
        "title_el": "Η πισίνα έκλεισε και οι κολυμβητές έμειναν να περιμένουν",
        "status": "translation_needed"
      },
      {
        "id": 16,
        "title_el": "Η αποστολή του στίβου και τα μπλόκα στην εθνική οδό",
        "status": "translation_needed"
      },
      {
        "id": 17,
        "title_el": "Οι αγώνες τελείωσαν, ο λογαριασμός όχι: 30.000 δραχμές για τα Δίια",
        "status": "translation_needed"
      },
      {
        "id": 18,
        "title_el": "Κέρδισε την έγχρωμη τηλεόραση και επέστρεψε κάτι στον Αρχέλαο",
        "status": "translation_needed"
      },
      {
        "id": 19,
        "title_el": "Το βόλεϊ προπονούνταν όταν το γυμναστήριο είχε σχολάσει",
        "status": "translation_needed"
      },
      {
        "id": 20,
        "title_el": "Το αρχείο που βρέθηκε σε άλλα γραφεία",
        "status": "translation_needed"
      },
      {
        "id": 21,
        "title_el": "Να παίξουμε και τα δύο ευρωπαϊκά στην Ισπανία;",
        "status": "translation_needed"
      }
    ],
    "museum": "English text is mixed into source HTML. Separate extraction and editorial review required.",
