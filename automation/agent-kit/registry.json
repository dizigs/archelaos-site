      "access": "repo-scoped; reviewer-gated writes",
      "budget": "existing-service",
      "commands": [
        {
          "id": "checks",
          "run": "gh pr checks <PR_NUMBER> --repo dizigs/archelaos-site",
          "mode": "read"
        },
        {
          "id": "workflow",
          "run": "gh run view <RUN_ID> --repo dizigs/archelaos-site --log",
          "mode": "read"
