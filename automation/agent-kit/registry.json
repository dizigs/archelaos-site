  "stateDefinitions": {
    "verified": "Evidence of some real access or execution, not necessarily live end-to-end",
    "reported": "Recorded in private registry or earlier work, not rechecked in this change",
    "paused": "Previously trialled but live integration currently disabled",
    "candidate": "Discovered tool; not installed or authorized"
