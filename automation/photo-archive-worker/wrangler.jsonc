{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "archelaos-photo-archive-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PHOTO_ARCHIVE_ENABLED": "false",
    "PHOTO_INTAKE_ENABLED": "false",
    "PHOTO_EU_REVIEW_APPROVED": "false",
    "PHOTO_PUBLIC_SUBMISSIONS_ENABLED": "false",
    "PHOTO_PUBLISH_ENABLED": "false"
  },
  "r2_buckets": [
    {
      "binding": "PHOTO_ORIGINALS",
      "bucket_name": "archelaos-photo-originals"
    },
    {
      "binding": "PHOTO_PUBLISHED",
      "bucket_name": "archelaos-photo-published"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
